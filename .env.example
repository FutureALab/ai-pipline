# ==============================================================================
# OpenAI 协议模型配置模板（支持 Response API 与 Chat Completions API 两种模式）
# ==============================================================================

# 1. 选择当前使用的 API 模式：chat | responses
OPENAI_API_MODE=chat

# 2. 通用配置
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4o
OPENAI_API_KEY=sk-your-api-key-here

# 3. Response API 模式独立配置（可选，优先于通用配置）
OPENAI_RESPONSES_BASE_URL=https://api.openai.com/v1
OPENAI_RESPONSES_MODEL_NAME=gpt-4.1
OPENAI_RESPONSES_API_KEY=

# 4. Chat API 模式独立配置（可选，优先于通用配置）
OPENAI_CHAT_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL_NAME=gpt-4o
OPENAI_CHAT_API_KEY=

# 5. 可选高级参数
OPENAI_CONTEXT_WINDOW=128000
OPENAI_MAX_TOKENS=16384

# 6. OpenTelemetry AI Trace 遥测配置
OTEL_ENABLED=true
OTEL_SERVICE_NAME=ai-pipline2
OTEL_CAPTURE_CONTENT=summary
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

# 7. 多数据库配置（基于 Kysely 查询构建器，支持 postgres | mysql | gauss | sqlite | auto）
DB_DRIVER=auto
DB_INIT_SEED=true
DB_ALLOW_SQLITE_FALLBACK=true
SQLITE_PATH=data/ai-pipeline.sqlite

# 7.1 PostgreSQL（pg）
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_pipeline

# 7.2 MySQL（mysql2，设置 DB_DRIVER=mysql 时生效）
# MYSQL_URL=mysql://root:root@127.0.0.1:3306/ai_pipeline
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=root
# MYSQL_DATABASE=ai_pipeline

# 7.3 GaussDB / openGauss（gaussdb-nodejs，设置 DB_DRIVER=gauss 时生效）
# GAUSS_URL=gaussdb://gaussdb:password@127.0.0.1:8000/ai_pipeline
# GAUSSHOST=127.0.0.1
# GAUSSPORT=8000
# GAUSSUSER=gaussdb
# GAUSSPASSWORD=
# GAUSSDATABASE=ai_pipeline

# 7.4 跨部门多数据源同时连接（支持同时连多个 PG/MySQL/GaussDB/SQLite，密码均支持 ENC(...)）
# DB_DATASOURCES=[{"name":"dept_order_mysql","driver":"mysql","host":"10.0.0.11","port":3306,"user":"readonly","password":"ENC(...)","database":"order_db"},{"name":"dept_dw_gauss","driver":"gauss","host":"10.0.0.12","port":8000,"user":"analyst","password":"ENC(...)","database":"dw_db"}]

# 8. Jenkins 多节点轮询 + 熔断配置
# 单节点配置（向后兼容）
JENKINS_URL=http://localhost:8080
# 多节点逗号分隔（共享以下账号/Token）
# JENKINS_URLS=http://jenkins-1:8080,http://jenkins-2:8080,http://jenkins-3:8080
# 或多节点独立鉴权 JSON（优先级高于 JENKINS_URLS / JENKINS_URL）
# JENKINS_NODES=[{"id":"jk-1","baseUrl":"http://jenkins-1:8080","username":"admin","apiToken":"tok1"},{"id":"jk-2","baseUrl":"http://jenkins-2:8080","username":"admin","apiToken":"tok2"}]
JENKINS_USER=admin
JENKINS_PASSWORD=admin123
JENKINS_API_TOKEN=
JENKINS_DEFAULT_JOB=ai-skill-pipeline
JENKINS_CONCURRENCY_SEMAPHORE=5
# 熔断退避时间（默认 3000ms），半开态接收 1/3 流量（JENKINS_CB_HALF_OPEN_DIVISOR=3）
JENKINS_CB_BACKOFF_MS=3000
JENKINS_CB_HALF_OPEN_DIVISOR=3

# 9. Redis Sentinel 哨兵 & BullMQ 阻塞队列配置
REDIS_ENABLED=true
REDIS_MODE=sentinel
REDIS_SENTINELS=127.0.0.1:26379,127.0.0.1:26380,127.0.0.1:26381
REDIS_SENTINEL_MASTER=mymaster
# REDIS_SENTINEL_NAT_MAP={"redis-master:6379":{"host":"127.0.0.1","port":6379},"redis-replica:6379":{"host":"127.0.0.1","port":6380}}
# REDIS_SENTINEL_PASSWORD=
# REDIS_SENTINEL_ROLE=master
# REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX={ai_pipeline}
# 如需切换集群或单机模式：REDIS_MODE=cluster | standalone
# REDIS_CLUSTER_NODES=127.0.0.1:7001,127.0.0.1:7002,127.0.0.1:7003
# REDIS_URL=redis://localhost:6379/0
REDIS_ALLOW_FALLBACK=true
# 跨部门多 Redis 实例同时连接（支持同时连多个 standalone / sentinel / cluster，密码均支持 ENC(...)）
# REDIS_INSTANCES=[{"name":"sso","mode":"standalone","host":"10.0.0.21","port":6379,"password":"ENC(...)","db":0},{"name":"dept_cache","mode":"sentinel","sentinels":"10.0.0.22:26379","masterName":"deptmaster","password":"ENC(...)"}]

# 10. Jasypt 风格盐值加解密（所有数据库/Redis/Jenkins/SMTP/OpenAI 密码均支持 ENC(...) 密文）
# 生成密文命令：bun run src/main.ts encrypt "your-secret"
JASYPT_ENCRYPTOR_PASSWORD=change-this-master-secret
# JASYPT_ENCRYPTOR_SALT=optional-static-pepper

# 11. 第三方 OAuth 认证 & Redis 会话校验配置
# 设为 true 时所有 /api/* 请求强制校验 Redis Token；/api/auth/me 始终严格校验 Redis
AUTH_REQUIRED=false
# 指定认证 Token 所在 Redis 实例名称（默认 primary，可指向 REDIS_INSTANCES 中的跨部门单机 Redis 如 sso）
AUTH_REDIS_INSTANCE=primary
AUTH_REDIS_KEY_PREFIX=auth:token:
AUTH_SESSION_TTL_SECONDS=86400
# AUTH_JWT_SECRET=ENC(...)
OAUTH_PROVIDER_NAME=OAuth2 SSO
# OAUTH_AUTHORIZE_URL=https://sso.example.com/oauth/authorize
# OAUTH_TOKEN_URL=https://sso.example.com/oauth/token
# OAUTH_USERINFO_URL=https://sso.example.com/oauth/userinfo
# OAUTH_CLIENT_ID=your-client-id
# OAUTH_CLIENT_SECRET=ENC(...)
# OAUTH_REDIRECT_URI=http://localhost:5173
OAUTH_SCOPE=openid profile email

# 12. SMTP 告警与通知邮件配置（密码支持 ENC(...) 密文）
ALERT_EMAIL_ENABLED=false
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=alerts@example.com
# SMTP_PASSWORD=ENC(...)
# SMTP_FROM=AI-Pipeline <alerts@example.com>
# ALERT_EMAIL_TO=ops@example.com

