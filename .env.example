# ==============================================================================
# OpenAI 协议模型配置模板（支持 Response API 与 Chat Completions API 两种模式）
# ==============================================================================

# 1. 选择当前使用的 API 模式：chat | responses
OPENAI_API_MODE=chat

# 2. 通用配置
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4o
OPENAI_API_KEY=sk-your-api-key-here

# 3. Response API 模式独立配置（可选，优先于通用配置）
OPENAI_RESPONSES_BASE_URL=https://api.openai.com/v1
OPENAI_RESPONSES_MODEL_NAME=gpt-4.1
OPENAI_RESPONSES_API_KEY=

# 4. Chat API 模式独立配置（可选，优先于通用配置）
OPENAI_CHAT_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL_NAME=gpt-4o
OPENAI_CHAT_API_KEY=

# 5. 可选高级参数
OPENAI_CONTEXT_WINDOW=128000
OPENAI_MAX_TOKENS=16384

# 6. OpenTelemetry AI Trace 遥测配置
OTEL_ENABLED=true
OTEL_SERVICE_NAME=ai-pipline2
OTEL_CAPTURE_CONTENT=summary
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

# 7. PostgreSQL 数据库配置
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_pipeline
DB_INIT_SEED=true
SQLITE_PATH=data/ai-pipeline.sqlite

# 8. Jenkins 远程调用配置
JENKINS_URL=http://localhost:8080
JENKINS_USER=admin
JENKINS_API_TOKEN=
JENKINS_DEFAULT_JOB=ai-skill-pipeline

# 9. Redis 连接配置
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0
REDIS_ALLOW_FALLBACK=true
