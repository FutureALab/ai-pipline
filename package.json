{
  "name": "ai-pipline2",
  "version": "1.0.0",
  "description": "AI Skill Generator & Jenkins Pipeline Runner powered by @oh-my-pi/pi-coding-agent SDK",
  "type": "module",
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22.0.0"
  },
  "scripts": {
    "generate": "bun run src/main.ts generate",
    "run-skill": "bun run src/main.ts run",
    "serve": "bun run src/main.ts serve",
    "jenkins:up": "bun run scripts/setup-jenkins.ts",
    "prisma:generate": "./node_modules/.bin/prisma generate && ./node_modules/.bin/prisma generate --schema=prisma/schema.mysql.prisma",
    "prisma:push": "./node_modules/.bin/prisma db push",
    "typecheck": "tsc --noEmit",
    "build": "bun run scripts/build-binaries.ts darwin-arm64",
    "build:linux": "bun run scripts/build-binaries.ts linux-x64",
    "build:linux-arm64": "bun run scripts/build-binaries.ts linux-arm64",
    "build:mac": "bun run scripts/build-binaries.ts darwin-arm64",
    "build:mac-x64": "bun run scripts/build-binaries.ts darwin-x64",
    "build:win": "bun run scripts/build-binaries.ts win32-x64",
    "build:all": "bun run scripts/build-binaries.ts all"
  },
  "dependencies": {
    "@oh-my-pi/pi-coding-agent": "18.22.1",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bullmq": "^6.7.8",
    "gaussdb-nodejs": "^0.2.3",
    "ioredis": "^6.0.0",
    "jose": "^6.2.18",
    "kysely": "^0.29.9",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.1",
    "typescript": "^5.7.0"
  }
}